#!/bin/bash
set -euo pipefail
LIBDIR=/usr/lib
if [[ -d /usr/lib64/openjfx17-gnujason ]]; then LIBDIR=/usr/lib64; fi
JAVA_HOME="${JAVA_HOME:-$LIBDIR/jvm/java-21-openjdk}"
JAVAFX_LIB="${JAVAFX_LIB:-/usr/share/java/openjfx17-gnujason}"
NOTESY_JAR="${NOTESY_JAR:-/usr/share/notesy/notesy.jar}"
SQLITE_JAR="${SQLITE_JAR:-$LIBDIR/java/sqlite-jdbc.jar}"
JAVAFX_NATIVE="${JAVAFX_NATIVE:-$LIBDIR/openjfx17-gnujason}"
exec "$JAVA_HOME/bin/java" \
    -Djava.library.path="$JAVAFX_NATIVE:$LIBDIR" \
    -cp "$NOTESY_JAR:$SQLITE_JAR:$JAVAFX_LIB/*" org.stickynotefx.Launcher "$@"